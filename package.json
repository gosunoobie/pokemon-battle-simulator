{
  "name": "pokemon-battle-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node apps/server/start.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:simulation": "node --test tests/simulation-*.test.mjs",
    "test:multiplayer": "node --test tests/multiplayer-*.test.mjs",
    "test:engine": "node --test packages/battle-engine/tests/*.test.mjs",
    "engine:demo": "node packages/battle-engine/examples/headless.mjs",
    "data:setup": "npm ci --prefix tools/data-import --ignore-scripts --omit=optional --no-audit --no-fund",
    "data:import": "node tools/data-import/import.mjs",
    "data:check": "node tools/data-import/import.mjs --check",
    "test:data": "node --test tools/data-import/tests/*.test.mjs packages/game-data/tests/*.test.mjs",
    "roster:setup": "npm ci --prefix tools/roster-import --ignore-scripts --no-audit --no-fund",
    "roster:fetch": "node tools/roster-import/import.mjs --fetch",
    "roster:import": "node tools/roster-import/import.mjs",
    "roster:check": "node tools/roster-import/import.mjs --check",
    "test:roster": "node --test tools/roster-import/tests/*.test.mjs",
    "audio:optimize": "node tools/audio-import/import.mjs",
    "audio:check": "node tools/audio-import/import.mjs --check",
    "test:audio": "node --test tools/audio-import/tests/*.test.mjs",
    "cries:inventory": "node tools/cry-import/inventory.mjs",
    "cries:inventory:check": "node tools/cry-import/inventory.mjs --check",
    "cries:check": "node tools/cry-import/assets.mjs --check",
    "cries:setup": "npm ci --prefix tools/cry-import --ignore-scripts --no-audit --no-fund",
    "cries:fetch": "node tools/cry-import/fetch.mjs",
    "cries:import": "node tools/cry-import/assets.mjs",
    "cries:verify-source": "node tools/cry-import/inventory.mjs --verify-remote",
    "test:cries": "node --test tools/cry-import/tests/*.test.mjs"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "pixi.js": "^8.13.0",
    "gsap": "^3.13.0",
    "@battle/battle-core": "file:packages/battle-core",
    "@battle/battle-fx": "file:packages/battle-fx",
    "@battle/battle-audio": "file:packages/battle-audio",
    "@battle/pokemon-cries": "file:packages/pokemon-cries",
    "@battle/pokemon-sprites": "file:packages/pokemon-sprites"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "@vitejs/plugin-vue": "^6.0.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
